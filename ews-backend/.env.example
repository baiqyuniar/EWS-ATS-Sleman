# Database
DATABASE_URL="postgresql://ews_user:ews_password@localhost:5432/ews_aps_sleman?schema=public"

# JWT — WAJIB diganti string acak unik sebelum deploy (aplikasi menolak start jika
# masih placeholder ini, atau kurang dari 32 karakter di production).
# Generate: openssl rand -base64 48
JWT_SECRET="change-this-to-a-long-random-secret-in-production"
JWT_EXPIRES_IN="8h"

# App
PORT=3000
NODE_ENV=development

# CORS — daftar origin frontend yang diizinkan, pisahkan dengan koma untuk lebih
# dari satu (mis. domain staging + production). Kosongkan di dev untuk default
# http://localhost:5173.
CORS_ORIGIN="http://localhost:5173"

# Rate limiting (lihat main.ts) — batas request per menit per IP.
THROTTLE_LIMIT=100
# Batas khusus percobaan login per menit per IP (mitigasi brute-force).
THROTTLE_LOGIN_LIMIT=5

# Set "true" untuk tetap mengaktifkan Swagger docs (/api/docs) di production.
# Default: nonaktif di production untuk mengurangi permukaan reconnaissance.
ENABLE_SWAGGER_IN_PROD="false"

# Uploads (local disk storage for MVP; swap to S3/MinIO for production)
UPLOAD_DIR="./uploads"

# ML Service (ews-ml-service) - wrapper for the ewsDropOut XGBoost model.
# Leave empty to fall back to the temporary rule-based scoring engine.
ML_SERVICE_URL="http://localhost:8000"
